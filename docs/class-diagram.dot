digraph ClassDiagram {
  graph [fontname="Arial", fontsize=14, rankdir=TB, nodesep=0.7, ranksep=0.9, pad=0.4,
         label="UML Class Diagram: Система управління послугами хімчистки (варіант 12)", labelloc=t];
  node  [shape=plaintext, fontname="Arial", fontsize=11];
  edge  [fontname="Arial", fontsize=10, color="#333333"];

  Client [label=<
    <table border="0" cellborder="1" cellspacing="0" cellpadding="5">
      <tr><td bgcolor="#dbe8ff"><b>Client</b></td></tr>
      <tr><td align="left" balign="left">-id: int<br align="left"/>-fullName: str<br align="left"/>-phone: str<br align="left"/>-registeredAt: date<br align="left"/>-orders: list[Order]<br align="left"/></td></tr>
      <tr><td align="left" balign="left">+update(fullName: str, phone: str)<br align="left"/>+hasActiveOrders(): bool<br align="left"/>+isRegular(): bool<br align="left"/></td></tr>
    </table>>];

  Order [label=<
    <table border="0" cellborder="1" cellspacing="0" cellpadding="5">
      <tr><td bgcolor="#dbe8ff"><b>Order</b></td></tr>
      <tr><td align="left" balign="left">-number: int<br align="left"/>-client: Client<br align="left"/>-acceptedAt: date<br align="left"/>-readyDate: date<br align="left"/>-isUrgent: bool<br align="left"/>-status: OrderStatus<br align="left"/>-discount: Decimal<br align="left"/>-totalPrice: Decimal<br align="left"/>-issuedAt: date<br align="left"/>-items: list[OrderItem]<br align="left"/></td></tr>
      <tr><td align="left" balign="left">+addItem(item: OrderItem)<br align="left"/>+removeItem(item: OrderItem)<br align="left"/>+calculateTotal(): Decimal<br align="left"/>+calculateReadyDate(): date<br align="left"/>+changeStatus(newStatus: OrderStatus)<br align="left"/>+cancel()<br align="left"/>+issue(paymentConfirmed: bool)<br align="left"/></td></tr>
    </table>>];

  OrderItem [label=<
    <table border="0" cellborder="1" cellspacing="0" cellpadding="5">
      <tr><td bgcolor="#dbe8ff"><b>OrderItem</b></td></tr>
      <tr><td align="left" balign="left">-id: int<br align="left"/>-itemType: str<br align="left"/>-material: Material<br align="left"/>-color: str<br align="left"/>-defects: str<br align="left"/>-price: Decimal<br align="left"/>-services: dict[Service, Decimal]<br align="left"/></td></tr>
      <tr><td align="left" balign="left">+addService(service: Service, price: Decimal)<br align="left"/>+removeService(service: Service)<br align="left"/>+calculatePrice(): Decimal<br align="left"/>+hasService(service: Service): bool<br align="left"/></td></tr>
    </table>>];

  Service [label=<
    <table border="0" cellborder="1" cellspacing="0" cellpadding="5">
      <tr><td bgcolor="#dbe8ff"><b>Service</b></td></tr>
      <tr><td align="left" balign="left">-id: int<br align="left"/>-name: str<br align="left"/>-basePrice: Decimal<br align="left"/>-durationDays: int<br align="left"/>-isActive: bool<br align="left"/></td></tr>
      <tr><td align="left" balign="left">+update(name: str, basePrice: Decimal, durationDays: int)<br align="left"/>+activate()<br align="left"/>+deactivate()<br align="left"/>+isAvailable(): bool<br align="left"/></td></tr>
    </table>>];

  OrderStatus [label=<
    <table border="0" cellborder="1" cellspacing="0" cellpadding="5">
      <tr><td bgcolor="#f2f2f2"><i>&lt;&lt;enumeration&gt;&gt;</i><br/><b>OrderStatus</b></td></tr>
      <tr><td align="left" balign="left">ACCEPTED<br align="left"/>IN_PROGRESS<br align="left"/>READY<br align="left"/>ISSUED<br align="left"/>CANCELLED<br align="left"/></td></tr>
    </table>>];

  Material [label=<
    <table border="0" cellborder="1" cellspacing="0" cellpadding="5">
      <tr><td bgcolor="#f2f2f2"><i>&lt;&lt;enumeration&gt;&gt;</i><br/><b>Material</b></td></tr>
      <tr><td align="left" balign="left">NORMAL (коеф. 1.0)<br align="left"/>DELICATE (коеф. 1.3)<br align="left"/>LEATHER_FUR (коеф. 1.5)<br align="left"/></td></tr>
    </table>>];

  // Асоціація: клієнт оформлює 0..* замовлень
  Client -> Order [taillabel="1", headlabel="0..*", label=" оформляє", arrowhead=none];

  // Композиція: замовлення містить від 1 до 20 речей
  Order -> OrderItem [dir=both, arrowtail=diamond, arrowhead=none, taillabel="1", headlabel="1..20", label=" містить"];

  // Асоціація: річ має 1..* послуг, послуга використовується в 0..* речах
  OrderItem -> Service [arrowhead=vee, taillabel="0..*", headlabel="1..*", label=" вибрані послуги"];

  // Залежності від переліків
  Order -> OrderStatus [style=dashed, arrowhead=vee, label=" «uses»"];
  OrderItem -> Material [style=dashed, arrowhead=vee, label=" «uses»"];

  { rank=same; Client; Order; }
  { rank=same; OrderItem; Service; }
}
